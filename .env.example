# Bot tokens — fill in and rename this file to .env
TELEGRAM_TOKEN=your_telegram_bot_token_here
DISCORD_TOKEN=your_discord_bot_token_here

# Your Telegram user ID for admin alerts (get from @userinfobot)
ADMIN_ID=0

# Comma-separated list of platforms to run
ENABLED_PLATFORMS=telegram

# Directory for temporary downloads
TEMP_DIR=downloads

# Concurrency: max simultaneous downloads
MAX_WORKERS=4

# Max queued requests before rejecting new ones
QUEUE_SIZE=100
